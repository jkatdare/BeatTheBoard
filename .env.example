# NJ TRANSIT Developer Portal credentials
# Register + request RailData access at https://developer.njtransit.com
# Each API needs administrator approval before tokens will work.
NJT_USERNAME=your_portal_username
NJT_PASSWORD=your_portal_password

# --- optional overrides (defaults shown) ---
# NJT_STATION=NY              # NY = New York Penn Station
# NJT_POLL_SECONDS=30         # 30s = ~2.9k calls/day vs the ~40k/day limit
# NJT_DB=track_history.db
# NJT_TOKEN_TTL_HOURS=12      # token minting is rate-limited; cache aggressively
# NJT_HOST=https://raildata.njtransit.com
#   test environment: https://testraildata.njtransit.com
